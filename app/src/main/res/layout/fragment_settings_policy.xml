<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Top bar: Back + Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/action_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/privacy_policy_title"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/text_secondary" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Last updated -->
            <TextView
                android:id="@+id/tvLastUpdated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/privacy_last_updated"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="16dp"/>

            <!-- Section helper style: headline -->
            <TextView
                style="@style/TextAppearance.App.Headline2"
                android:text="@string/privacy_section_overview" />

            <TextView
                style="@style/TextAppearance.App.Body1"
                android:layout_marginTop="6dp"
                android:text="@string/privacy_overview_body" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/text_secondary" />

            <TextView
                style="@style/TextAppearance.App.Headline2"
                android:text="@string/privacy_section_data_we_collect" />

            <TextView
                style="@style/TextAppearance.App.Body1"
                android:layout_marginTop="6dp"
                android:text="@string/privacy_collect_intro" />

            <!-- Bullets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">

                <TextView
                    style="@style/TextAppearance.App.Body1"
                    android:text="• Account info (name, email)" />
                <TextView
                    style="@style/TextAppearance.App.Body1"
                    android:text="• Usage data (app interactions, crash logs)" />
                <TextView
                    style="@style/TextAppearance.App.Body1"
                    android:text="• Location (only if you grant permission, to find nearby coffee places)" />
                <TextView
                    style="@style/TextAppearance.App.Body1"
                    android:text="• Device identifiers (for analytics and fraud prevention)" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/text_secondary" />

            <TextView
                style="@style/TextAppearance.App.Headline2"
                android:text="@string/privacy_section_how_we_use_data" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Provide and improve app features" />
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Personalize content and recommendations" />
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Process authentication and keep the app secure" />
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Debug issues, measure performance and usage" />
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Send push notifications (you can toggle these in Settings)" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/text_secondary" />

            <TextView
                style="@style/TextAppearance.App.Headline2"
                android:text="@string/privacy_section_sharing" />

            <TextView
                style="@style/TextAppearance.App.Body1"
                android:layout_marginTop="6dp"
                android:text="@string/privacy_sharing_body" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/text_secondary" />

            <TextView
                style="@style/TextAppearance.App.Headline2"
                android:text="@string/privacy_section_permissions" />

            <TextView
                style="@style/TextAppearance.App.Body1"
                android:layout_marginTop="6dp"
                android:text="@string/privacy_permissions_body" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/text_secondary" />

            <TextView
                style="@style/TextAppearance.App.Headline2"
                android:text="@string/privacy_section_your_choices" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Manage permissions in Android Settings" />
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Toggle push notifications in the app’s Settings" />
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Request account deletion from Settings → Delete Account" />
                <TextView style="@style/TextAppearance.App.Body1"
                    android:text="• Clear cached data from Settings → Data" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="16dp"
                android:background="@color/text_secondary" />

            <TextView
                style="@style/TextAppearance.App.Headline2"
                android:text="@string/privacy_section_contact" />

            <TextView
                style="@style/TextAppearance.App.Body1"
                android:layout_marginTop="6dp"
                android:text="@string/privacy_contact_body" />

            <!-- Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="24dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
