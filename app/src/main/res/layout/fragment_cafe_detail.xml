<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header image with overlay buttons -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="260dp">

            <ImageView
                android:id="@+id/ivHeader"
                android:layout_width="match_parent"
                android:layout_height="278dp"
                android:contentDescription="Cafe header"
                android:scaleType="centerCrop"
                android:src="@drawable/featured_placeholder" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="16dp"
                android:layout_marginTop="60dp"
                android:layout_marginEnd="16dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    android:background="@drawable/circle_white_bg"
                    android:contentDescription="Back"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/btnHeart"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_favorite_border"
                    android:background="@drawable/circle_white_bg"
                    android:contentDescription="Favourite"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="true"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvCafeName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Truth Coffee Roasting"
                        android:textColor="@android:color/black"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Stars + rating + distance row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star"/>
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_star"/>

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="4.5"
                            android:textColor="#7A7A7A"
                            android:textSize="14sp"/>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="12dp"
                            android:src="@drawable/ic_pin"
                            android:tint="#7A7A7A"/>

                        <TextView
                            android:id="@+id/tvDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="1.2 km away"
                            android:textColor="#7A7A7A"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- About -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="About"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Quirky cafe that's a steampunk world of pipes and old metal, with gourmet, home-roasted coffee."
                        android:textColor="#333333"
                        android:textSize="14sp"/>

                    <!-- Opening hours -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Opening Hours"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Monday - Saturday      7:00 am - 10:00 pm"
                            android:textColor="#333333"
                            android:textSize="14sp"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sunday                     8:00 am - 10:00 pm"
                            android:textColor="#333333"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Contact -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Contact"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_location"
                            android:tint="#7A7A7A"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="36 Buitenkant St, Cape Town City Centre, Cape Town, 8000"
                            android:textColor="#333333"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageView
                            android:id="@+id/btnCall"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_phone"
                            android:tint="#7A7A7A"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="021 201 7000"
                            android:textColor="#333333"
                            android:textSize="14sp"/>
                    </LinearLayout>

                    <!-- Review button -->
                    <TextView
                        android:id="@+id/btnReview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingVertical="14dp"
                        android:gravity="center"
                        android:text="Review"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_pill_dark"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Top Reviews header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Top Reviews"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:textSize="20sp"/>

            <!-- Sample review items (static includes) -->
            <include layout="@layout/item_review"/>
            <include layout="@layout/item_review"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
