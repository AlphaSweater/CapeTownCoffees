<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Content scroll -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Top close -->
            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="×"
                android:textSize="40sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="10dp"
                android:padding="4dp" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a List"
                android:textStyle="bold"
                android:textSize="28sp"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"/>

            <!-- List name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="List name"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:layout_marginTop="24dp"/>

            <EditText
                android:id="@+id/etListName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rounded_square"
                android:hint="Ex: Coffee Dates"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required Field"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginTop="6dp"/>

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:layout_marginTop="40dp"/>

            <EditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top|start"
                android:background="@drawable/rounded_square"
                android:padding="14dp"
                android:hint="Add a description"
                android:textColor="@android:color/black"
                android:textColorHint="@color/text_tip"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What is this list for?"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginTop="6dp"/>

            <!-- Privacy Level row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="30dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Privacy Level"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/privacyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_dark"
                    android:text="Public ▾"
                    android:textColor="@color/text_alt"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"/>
            </LinearLayout>

            <!-- Spacer to push content above bottom bar in smaller screens -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom bar with Save button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/btnSaveList"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="14dp"
            android:gravity="center"
            android:text="Save"
            android:textColor="@color/text_alt"
            android:textStyle="bold"
            android:textSize="20sp"
            android:background="@drawable/bg_pill_dark"/>
    </LinearLayout>
</RelativeLayout>
