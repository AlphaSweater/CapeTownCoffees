<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_ctc_cross"
            android:contentDescription="@string/close" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="@string/tell_others_about_your_experience"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="28sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/share_your_experience_with_the_community"
        android:textColor="@color/text_primary"
        android:textSize="14sp"/>

    <EditText
        android:id="@+id/etReview"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_margin="16dp"
        android:background="@drawable/rounded_square"
        android:gravity="top|start"
        android:hint="@string/consider_discussing_the_facilities_pricing_and_taste"
        android:padding="16dp"
        android:textColorHint="@color/text_tip"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Progress bar dots/lines -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <View android:layout_width="70dp" android:layout_height="8dp" android:background="@color/button_category"/>
            <View android:layout_width="70dp" android:layout_height="8dp" android:layout_marginStart="12dp" android:background="@color/button_category"/>
            <View android:layout_width="70dp" android:layout_height="8dp" android:layout_marginStart="12dp" android:background="@color/icon_blank_bar"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:layout_margin="20dp"
            android:text="@string/next"
            android:textColor="@color/text_alt"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_dark"/>
    </LinearLayout>
</LinearLayout>
