<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="16dp">

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            android:contentDescription="Close" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Tell others about your\nexperience"
        android:textColor="@android:color/black"
        android:textStyle="bold"
        android:textSize="28sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:text="Share your experience with the community"
        android:textColor="#7A7A7A"
        android:textSize="14sp"/>

    <EditText
        android:id="@+id/etReview"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_input_rounded"
        android:gravity="top|start"
        android:hint="Consider discussing the facilities, pricing and taste"
        android:padding="16dp"
        android:textColorHint="#BDBDBD"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Progress: middle step active -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <View android:layout_width="64dp" android:layout_height="4dp" android:background="#E0E0E0"/>
            <View android:layout_width="64dp" android:layout_height="4dp" android:layout_marginStart="12dp" android:background="#2C2118"/>
            <View android:layout_width="64dp" android:layout_height="4dp" android:layout_marginStart="12dp" android:background="#E0E0E0"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="12dp"
            android:text="Next"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_dark"/>
    </LinearLayout>
</LinearLayout>
