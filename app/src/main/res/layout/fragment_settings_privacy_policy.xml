<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_ctc_arrow_back"
            android:contentDescription="@string/action_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/privacy_policy_title"
            android:textStyle="bold"
            android:textSize="22sp"
            android:letterSpacing="0.01"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/privacy_overview_body"
                android:textSize="17sp"
                android:lineSpacingExtra="4dp"
                android:letterSpacing="0.005"
                android:hyphenationFrequency="normal"
                android:breakStrategy="balanced"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"

                android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"

            android:textAlignment="viewStart"
            android:gravity="start"/>

            <!-- ===== Data We Collect ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Heading -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_section_data_we_collect"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:lineHeight="24sp"
                        android:letterSpacing="0.01"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />

                    <!-- Full-width divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/text_secondary"/>

                    <!-- Intro -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_collect_intro"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:letterSpacing="0.005"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />

                    <!-- Bullets -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="•  Account info (name, email)"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="•  Usage data (interactions, crash logs)"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="•  Location (if granted, to find nearby coffee places)"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="•  Device identifiers (analytics/fraud prevention)"
                            android:textSize="15sp"
                            android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== How We Use Data ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_section_how_we_use_data"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:lineHeight="24sp"
                        android:letterSpacing="0.01"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/text_secondary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Provide and improve features"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Personalize content"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Authenticate and secure the app"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Debug, analytics, performance"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Send push notifications (toggle in Settings)"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Sharing ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_section_sharing"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:lineHeight="24sp"
                        android:letterSpacing="0.01"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/text_secondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_sharing_body"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:letterSpacing="0.005"
                        android:hyphenationFrequency="normal"
                        android:breakStrategy="balanced"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Permissions ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_section_permissions"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:lineHeight="24sp"
                        android:letterSpacing="0.01"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/text_secondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_permissions_body"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:letterSpacing="0.005"
                        android:includeFontPadding="false"
                        android:hyphenationFrequency="normal"
                        android:breakStrategy="balanced"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Your Choices ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_section_your_choices"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:lineHeight="24sp"
                        android:letterSpacing="0.01"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/text_secondary"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Manage permissions in Android Settings"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"
                            android:layout_marginBottom="2dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Toggle push notifications in Settings"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"
                            android:layout_marginBottom="2dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Request account deletion in Settings"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"
                            android:layout_marginBottom="2dp"/>
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="•  Clear cached data in Settings → Data"
                            android:textSize="15sp" android:lineSpacingExtra="2dp"
                            android:includeFontPadding="false" android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Contact ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardUseCompatPadding="true"
                app:cardPreventCornerOverlap="true"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_section_contact"
                        android:textStyle="bold"
                        android:textSize="19sp"
                        android:lineHeight="24sp"
                        android:letterSpacing="0.01"
                        android:includeFontPadding="false"
                        android:textColor="@color/text_primary" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/text_secondary"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_contact_body"
                        android:textSize="16sp"
                        android:lineSpacingExtra="4dp"
                        android:letterSpacing="0.005"
                        android:includeFontPadding="false"
                        android:hyphenationFrequency="normal"
                        android:breakStrategy="balanced"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
