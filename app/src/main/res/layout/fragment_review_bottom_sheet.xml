<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Top area: ONLY the drag handle, centered -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_bottom_sheet_handle" />
    </LinearLayout>

    <!-- Content card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_review_card"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header row: title + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Title: "Rate Bean There Coffee" etc -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/review_step1_title"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:src="@drawable/ic_ctc_cross"
                android:contentDescription="@string/close" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/review_step1_message"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Rating -->
        <androidx.appcompat.widget.AppCompatRatingBar
            android:id="@+id/ratingBar"
            style="@style/Widget.AppCompat.RatingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:isIndicator="false"
            android:numStars="5"
            android:stepSize="1"
            android:progressTint="@color/icon_star"
            android:secondaryProgressTint="@color/icon_star"
            android:progressBackgroundTint="@color/coffee_dark" />

        <!-- Optional text label -->
        <TextView
            android:id="@+id/tvReviewLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/review_step3_your_review"
            android:textAllCaps="true"
            android:textColor="@color/text_tip"
            android:textSize="12sp" />

        <!-- Review text -->
        <EditText
            android:id="@+id/etReview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/rounded_square"
            android:gravity="top|start"
            android:hint="@string/review_step2_example"
            android:padding="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tip"
            android:maxLines="5"
            android:inputType="textMultiLine" />

        <!-- Char count -->
        <TextView
            android:id="@+id/tvCharCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="0/300"
            android:textColor="@color/text_tip"
            android:textSize="12sp"
            android:gravity="end" />
    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnNotNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/review_back"
            android:textColor="@color/text_secondary"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_dark"
            android:paddingHorizontal="24dp"
            android:paddingVertical="8dp"
            android:text="@string/review_submit_button"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>