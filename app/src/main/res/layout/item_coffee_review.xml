<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Ctc.ElevatedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/ctc_card_lift">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ctc_content_padding_h"
        android:paddingEnd="@dimen/ctc_content_padding_h"
        android:paddingTop="@dimen/ctc_content_padding_t"
        android:paddingBottom="@dimen/ctc_content_padding_b">

        <!-- Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/profile_photo"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/constraintLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/constraintLayout"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ctc.Circle"
            tools:src="@drawable/bg_skeleton_circle" />

        <!-- Header (name + rating + chip) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="6dp"
            app:layout_constraintStart_toEndOf="@+id/ivAvatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints">

            <!-- Name -->
            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Alex Johnson" />

            <!-- Date -->
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/text_tip"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="@+id/tvAuthor"
                app:layout_constraintStart_toEndOf="@+id/tvAuthor"
                app:layout_constraintTop_toTopOf="@+id/tvAuthor"
                tools:text="• 2d ago" />

            <!-- Rating container -->
            <LinearLayout
                android:id="@+id/ratingContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="@id/tvAuthor"
                app:layout_constraintTop_toBottomOf="@id/tvAuthor">

                <!-- Stars -->
                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/ratingBar"
                    style="@style/Widget.Ctc.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:rating="4.5"
                    android:stepSize="0.5" />

                <!-- Numeric Rating -->
                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary"
                    tools:text="4.6" />

                <!-- Source Chip -->
                <TextView
                    android:id="@+id/tvSourceChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_soft"
                    android:maxLines="1"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/text_secondary"
                    tools:text="Google" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Actions (only for InAppReview; hide in code otherwise) -->
        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"

            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@+id/constraintLayout"

            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/constraintLayout"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLike"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/like"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_ctc_thumbs_up"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/success_green"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ctc.Circle"
                app:strokeColor="@color/success_green"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tvLikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/text_tip"
                tools:text="12" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDislike"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/dislike"
                app:backgroundTint="@android:color/transparent"
                app:icon="@drawable/ic_ctc_thumbs_down"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/error_red"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ctc.Circle"
                app:strokeColor="@color/error_red"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/tvDislikeCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/text_tip"
                tools:text="2" />

        </LinearLayout>


        <!-- Review text -->
        <TextView
            android:id="@+id/tvBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayout"
            tools:text="Smooth flat white, cozy vibes, friendly staff — solid Wi-Fi too." />

        <!-- ───────────────────── MOSAIC (adaptive) ───────────────────── -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/photosMosaic"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBody"
            app:layout_constraintDimensionRatio="16:9"
            tools:layout_height="200dp">

            <!-- Guidelines split -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gVert50"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gHorz50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_begin="0dp" />

            <!-- NOTE: default constraints = 2x2 GRID (used for 4+) -->

            <!-- top-left -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPhoto1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/gVert50"
                app:layout_constraintBottom_toTopOf="@id/gHorz50"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Ctc.TopLeftRounded16"
                tools:src="@drawable/featured_placeholder" />

            <!-- top-right -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPhoto2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="@id/gVert50"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/gHorz50"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Ctc.TopRightRounded16"
                tools:src="@drawable/featured_placeholder" />

            <!-- bottom-left -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPhoto3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/gHorz50"
                app:layout_constraintEnd_toStartOf="@id/gVert50"
                app:layout_constraintBottom_toBottomOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Ctc.BottomLeftRounded16"
                tools:src="@drawable/featured_placeholder" />

            <!-- bottom-right (with +N overlay) -->
            <FrameLayout
                android:id="@+id/photo4Container"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="@id/gVert50"
                app:layout_constraintTop_toBottomOf="@id/gHorz50"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivPhoto4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/featured_placeholder" />

                <View
                    android:id="@+id/moreScrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_mosaic_scrim"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvMoreBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="8dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_chip_soft"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="@color/text_primary"
                    android:visibility="gone"
                    tools:text="+4"
                    tools:visibility="visible" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Divider below mosaic -->
        <View
            android:id="@+id/dividerActions"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/divider_soft"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/photosMosaic" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
