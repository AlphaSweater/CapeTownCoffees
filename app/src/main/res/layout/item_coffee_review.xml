<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Ctc.ElevatedCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ctc_card_margin_h"
    android:layout_marginVertical="@dimen/ctc_card_margin_v"
    android:foreground="?attr/selectableItemBackground"
    android:stateListAnimator="@animator/ctc_card_lift">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/ctc_content_padding_h"
        android:paddingEnd="@dimen/ctc_content_padding_h"
        android:paddingTop="@dimen/ctc_content_padding_t"
        android:paddingBottom="@dimen/ctc_content_padding_b">

        <!-- Avatar -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/profile_photo"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Ctc.Circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_avatar_placeholder" />

        <!-- Author + rating + date in a single row -->
        <LinearLayout
            android:id="@+id/headerTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
            app:layout_constraintEnd_toStartOf="@id/tvDate"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="@color/text_primary"
                tools:text="Alex Johnson" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <!-- Rating bar -->
                <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/ratingBar"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:stepSize="0.5"
                    android:rating="4.5"
                    android:progressTint="@color/icon_star"
                    android:secondaryProgressTint="@color/icon_star"
                    android:indeterminateTint="@color/icon_star"/>

                <TextView
                    android:id="@+id/tvRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/text_secondary"
                    tools:text="4.5" />

                <!-- Small badge for source (“Google”, “In-App”) -->
                <TextView
                    android:id="@+id/tvSourceChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:background="@drawable/bg_chip_soft"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                    android:textColor="@color/text_secondary"
                    tools:text="Google" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="@color/text_tip"
            app:layout_constraintTop_toTopOf="@+id/ivAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="2d ago" />

        <!-- Review text -->
        <TextView
            android:id="@+id/tvBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="@id/ivAvatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivAvatar"
            tools:text="This spot has the smoothest flat white I’ve had in a while. Vibes are cozy, staff are super friendly, and Wi-Fi is solid." />

        <!-- Optional photo strip (hidden by default; show when review has photos) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPhotos"
            android:layout_width="0dp"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingEnd="4dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/tvBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBody"
            tools:visibility="visible"
            tools:itemCount="3" />

        <!-- Divider before actions; auto-hides if no actions -->
        <View
            android:id="@+id/dividerActions"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/divider_soft"
            app:layout_constraintStart_toStartOf="@id/tvBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rvPhotos" />

        <!-- Actions: Like / Dislike (only for InAppReview; hide for Google) -->
        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/tvBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dividerActions"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLike"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/like"
                app:icon="@drawable/ic_ctc_thumbs_up"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/icon_primary"
                tools:ignore="TouchTargetSizeCheck" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDislike"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/dislike"
                app:icon="@drawable/ic_ctc_thumbs_down"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/icon_primary"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

        <!-- Guard: if actions hidden, also hide divider via code -->
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>