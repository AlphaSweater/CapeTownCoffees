    <!-- Privacy Policy () -->
    <string name="privacy_policy_title">Umgaqo-nkqubo wabucala</string>
    <string name="privacy_section_overview">Isishwankathelo</string>
    <string name="privacy_overview_body">Siyawuhlonipha umthetho wabucala bakho. Lo mgaqo uchaza ukuba yeyiphi idatha iCape Town Coffees eqokelela yona, indlela esiyisebenzisa ngayo, kunye nokhetho onalo. Ngokusebenzisa usetyenziso, uyavumelana nendlela esisebenzisa ngayo ezi nkcukacha.</string>
    <string name="privacy_data_collect_intro">Siqokelela kuphela idatha esiyifunayo ukuze sisebenze kakuhle kwaye siphucule amava akho. Oku kungabandakanya:</string>
    <string name="privacy_data_collect_bullet1">• Ulwazi lweakhawunti (igama, imeyile)</string>
    <string name="privacy_data_collect_bullet2">• Idatha yokusebenzisa usetyenziso (iintshukumo, iingxaki/ukudilika)</string>
    <string name="privacy_data_collect_bullet3">• Indawo (ukuba uyivumile, ukufumana iindawo zekofu ezikufuphi)</string>
    <string name="privacy_data_collect_bullet4">• Iimpawu zesixhobo (uhlalutyo/kuthintelo ubuqhetseba)</string>

    <string name="privacy_use_data_title">Indlela esisebenzisa ngayo idatha</string>
    <string name="privacy_use_data_bullet1">• Ukunika nokuphucula izinto ezisebenzayo</string>
    <string name="privacy_use_data_bullet2">• Ukwenza umxholo uhlengahlengiswe kuwe</string>
    <string name="privacy_use_data_bullet3">• Ukuqinisekisa ukhuseleko nokungqina abasebenzisi</string>
    <string name="privacy_use_data_bullet4">• Uhlalutyo, ukulungisa iingxaki, nokusebenza kakuhle</string>
    <string name="privacy_use_data_bullet5">• Ukuthumela izaziso (ungazicima kwiisetingi)</string>

    <string name="privacy_sharing_title">Ukwabelana</string>
    <string name="privacy_sharing_body">
        Asithengisi datha yakho. Sabelana ngolwazi olulinganiselweyo kuphela nababoneleli beenkonzo (umz. uhlalutyo, iimephu, ingxelo yeengxaki) ukuze sisebenze ngcono, phantsi kwemigaqo-nkqubo yokhuseleko, okanye xa kufuneka ngumthetho.
    </string>

    <string name="privacy_permissions_title">Iimvume</string>
    <string name="privacy_permissions_body">
        Ezinye izinto zisebenza kuphela xa unike imvume (umz. indawo). Ungazilawula nangaliphi na ixesha kwiisetingi zesixhobo. Ukuba uyasusa imvume, ezinye izinto zingasebenzi.
    </string>

    <string name="privacy_your_choices_title">Ukhetho lwakho</string>
    <string name="privacy_your_choices_bullet1">• Lawula iimvume kwiisetingi zesixhobo</string>
    <string name="privacy_your_choices_bullet2">• Cima izaziso kwiisetingi</string>
    <string name="privacy_your_choices_bullet3">• Cela ukucinywa kweakhawunti yakho</string>
    <string name="privacy_your_choices_bullet4">• Sula idatha egciniweyo kwiisetingi → Idatha</string>

    <string name="privacy_contact_title">Qhagamshelana nathi</string>
    <string name="privacy_contact_body">Imibuzo okanye inkxalabo? Sibhalele ku: support@capetowncoffees.app</string>

