    <!-- privacy policy -->
    <string name="privacy_policy_title">Umgaqo Wabucala</string>
    <string name="privacy_section_overview">Ingcaciso</string>
    <string name="privacy_overview_body">Siyayihlonipha imfihlo yakho. Lo mgaqo-nkqubo uchaza ukuba yeyiphi idatha eqokelelwa yiCape Town Coffees, indlela esiyisebenzisa ngayo, kunye nokukhetha onako. Ngokusebenzisa iapp, uyavumelana nezenzo ezichazwe apha.</string>
    <string name="privacy_data_collect_intro">Siqokelela kuphela into esiyifunayo ukuqhuba iapp nokuphucula amava akho. Oku kungabandakanya:</string>
    <string name="privacy_data_collect_bullet1">• Ulwazi lweakhawunti (igama, i-imeyile)</string>
    <string name="privacy_data_collect_bullet2">• Idatha yokusetyenziswa (intsebenziswano, iilog zokungasebenzi kakuhle)</string>
    <string name="privacy_data_collect_bullet3">• Indawo (ukuba inikiwe, ukufumana iindawo zekofu ezikufutshane)</string>
    <string name="privacy_data_collect_bullet4">• Izikhombisi zesixhobo (i-analytics/uthintelo lobuqhophololo)</string>
    <string name="privacy_use_data_title">Indlela Esiyisebenzisa Ngayo Idatha Yakho</string>
    <string name="privacy_use_data_bullet1">• Ukunika nokuphucula iimpawu</string>
    <string name="privacy_use_data_bullet2">• Yenza umxholo ube ngowakho</string>
    <string name="privacy_use_data_bullet3">• Qinisekisa kwaye ukhusele iapp</string>
    <string name="privacy_use_data_bullet4">• Ukulungisa iimpazamo, i-analytics, kunye nokubeka iliso ekusebenzeni</string>
    <string name="privacy_use_data_bullet5">• Thumela izaziso zokutyhala (ungakwazi ukutshintsha oku kwiiSetingi)</string>
    <string name="privacy_sharing_title">Ukwabelana</string>
    <string name="privacy_sharing_body">Asiyithengisi idatha yakho yobuqu. Singabelana ngolwazi olulinganiselweyo kunye nababoneleli beenkonzo (umz. i-analytics, ingxelo yokuwa, iimephu/iindawo) ngokungqongqo ukuze sisebenzise iimpawu egameni lethu, phantsi kwezibophelelo zokugcina imfihlo, okanye xa kufunwa ngumthetho.</string>
    <string name="privacy_permissions_title">Iimvume</string>
    <string name="privacy_permissions_body">Ezinye iimpawu zifuna iimvume (umz. Indawo ukufumana iivenkile zekofu ezikufutshane). Ungazinika okanye uzirhoxise nanini na kwiiSetingi ze-Android. Ukuba urhoxisa imvume, iimpawu ezinxulumeneyo zisenokungasebenzi.</string>
    <string name="privacy_your_choices_title">Ukhetho Lwakho</string>
    <string name="privacy_your_choices_bullet1">• Lawula iimvume kwiiSetingi ze-Android</string>
    <string name="privacy_your_choices_bullet2">• Tshintsha izaziso zokutyhala kwiiSetingi</string>
    <string name="privacy_your_choices_bullet3">• Cela ukucinywa kweakhawunti kwiiSetingi</string>
    <string name="privacy_your_choices_bullet4">• Sula idatha egciniweyo kwiiSetingi → Idatha</string>
    <string name="privacy_contact_title">Qhagamshelana Nathi</string>
    <string name="privacy_contact_body">Imibuzo okanye iinkxalabo? Sithumele i-imeyile ku-support@capetowncoffees.app</string>

