    <!-- privacy policy -->
    <string name="privacy_policy_title">Privacy Policy</string>
    <string name="privacy_section_overview">Overview</string>
    <string name="privacy_overview_body">We respect your privacy. This policy explains what data Cape Town Coffees collects, how we use it, and the choices you have. By using the app, you agree to the practices described here.</string>
    <string name="privacy_data_collect_intro">We collect only what we need to run the app and improve your experience. This may include:</string>
    <string name="privacy_data_collect_bullet1">•  Account info (name, email)</string>
    <string name="privacy_data_collect_bullet2">•  Usage data (interactions, crash logs)</string>
    <string name="privacy_data_collect_bullet3">•  Location (if granted, to find nearby coffee places)</string>
    <string name="privacy_data_collect_bullet4">•  Device identifiers (analytics/fraud prevention)</string>
    <string name="privacy_use_data_title">How We Use Your Data</string>
    <string name="privacy_use_data_bullet1">•  Provide and improve features</string>
    <string name="privacy_use_data_bullet2">•  Personalize content</string>
    <string name="privacy_use_data_bullet3">•  Authenticate and secure the app</string>
    <string name="privacy_use_data_bullet4">•  Debug, analytics, and performance monitoring</string>
    <string name="privacy_use_data_bullet5">•  Send push notifications (you can toggle this in Settings)</string>
    <string name="privacy_sharing_title">Sharing</string>
    <string name="privacy_sharing_body">We do not sell your personal data. We may share limited information with service providers (e.g., analytics, crash reporting, maps/places) strictly to operate features on our behalf, under confidentiality obligations, or when required by law.</string>
    <string name="privacy_permissions_title">Permissions</string>
    <string name="privacy_permissions_body">Certain features require permissions (e.g., Location to find nearby coffee shops). You can grant or revoke them at any time in Android Settings. If you revoke a permission, related features may not work.</string>
    <string name="privacy_your_choices_title">Your Choices</string>
    <string name="privacy_your_choices_bullet1">•  Manage permissions in Android Settings</string>
    <string name="privacy_your_choices_bullet2">•  Toggle push notifications in Settings</string>
    <string name="privacy_your_choices_bullet3">•  Request account deletion in Settings</string>
    <string name="privacy_your_choices_bullet4">•  Clear cached data in Settings → Data</string>
    <string name="privacy_contact_title">Contact Us</string>
    <string name="privacy_contact_body">Questions or concerns? Email us at support@capetowncoffees.app</string>

