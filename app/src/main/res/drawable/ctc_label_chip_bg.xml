<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-opaque dark pill so it reads on any photo -->
    <solid android:color="@color/error_red"/> <!-- ~70% black -->
    <corners android:radius="999dp"/>
    <padding
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp"/>
    <!-- Optional subtle stroke to make it crisp on light photos -->
    <stroke android:width="1dp" android:color="@color/error_red"/>
</shape>
