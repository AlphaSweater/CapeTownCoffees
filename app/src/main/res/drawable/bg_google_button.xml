<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/google_button" />
            <stroke
                android:width="1dp"
                android:color="@color/google_button_stroke" />
            <corners android:radius="20dp" />
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />
        </shape>
    </item>
    
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/google_button" />
            <stroke
                android:width="1dp"
                android:color="@color/google_button_stroke" />
            <corners android:radius="20dp" />
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />
        </shape>
    </item>
    
    <!-- Focused state -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/google_button" />
            <stroke
                android:width="1dp"
                android:color="@color/google_button_stroke" />
            <corners android:radius="20dp" />
            <padding
                android:left="12dp"
                android:top="12dp"
                android:right="12dp"
                android:bottom="12dp" />
        </shape>
    </item>
</selector>
