<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/signInFragment">

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.synaptix.capetowncoffees.ui.auth.login.LoginFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_auth_login">

        <action
            android:id="@+id/action_authLoginFragment_to_authRegisterFragment"
            app:destination="@id/signUpFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_authLoginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.synaptix.capetowncoffees.ui.auth.register.RegisterFragment"
        android:label="Create Account"
        tools:layout="@layout/fragment_auth_register">

        <action
            android:id="@+id/action_signUpFragment_to_signInFragment"
            app:destination="@id/signInFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />

        <action
            android:id="@+id/action_authRegisterFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.synaptix.capetowncoffees.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home_new">

        <action
            android:id="@+id/action_homeFragment_self"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_homeFragment_to_cafeDetailFragment"
            app:destination="@id/cafeDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/cafeDetailFragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.CafeDetailFragment"
        android:label="Cafe Details"
        tools:layout="@layout/fragment_cafe_detail">
        <argument
            android:name="cafeName"
            app:argType="string" />
        <argument
            android:name="cafeRating"
            android:defaultValue="0.0"
            app:argType="float" />
        <argument
            android:name="cafeDistance"
            android:defaultValue="0.0"
            app:argType="float" />
        <argument
            android:name="cafePriceRange"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/savedFragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.SavedListsFragment"
        android:label="Saved"
        tools:layout="@layout/fragment_saved_lists">
        
        <action
            android:id="@+id/action_savedListsFragment_to_createListFragment"
            app:destination="@id/createListFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

        <action
            android:id="@+id/action_savedListsFragment_to_listDetailsFragment"
            app:destination="@id/listDetailsFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
            
    </fragment>

    <fragment
        android:id="@+id/listDetailsFragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.ListDetailsFragment"
        android:label="List Details"
        tools:layout="@layout/fragment_list_details">
        <argument
            android:name="listId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.synaptix.capetowncoffees.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">

        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.synaptix.capetowncoffees.ui.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/createListFragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.createSavedList.CreateListFragment"
        android:label="Create List"
        tools:layout="@layout/fragment_saved_create_list" />

    <fragment
        android:id="@+id/favouritesFragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.FavouritesFragment"
        android:label="Favourites"
        tools:layout="@layout/fragment_favourites" />

    <fragment
        android:id="@+id/reviewStep1Fragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.review.ReviewStep1Fragment"
        android:label="Review Step 1"
        tools:layout="@layout/fragment_review_step1" />

    <fragment
        android:id="@+id/reviewStep2Fragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.review.ReviewStep2Fragment"
        android:label="Review Step 2"
        tools:layout="@layout/fragment_review_step2" />

    <fragment
        android:id="@+id/reviewStep3Fragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.review.ReviewStep3Fragment"
        android:label="Review Step 3"
        tools:layout="@layout/fragment_review_step3" />

    <fragment
        android:id="@+id/reviewCompleteFragment"
        android:name="com.synaptix.capetowncoffees.ui.savedLists.review.ReviewCompleteFragment"
        android:label="Review Complete"
        tools:layout="@layout/fragment_review_complete" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.synaptix.capetowncoffees.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
