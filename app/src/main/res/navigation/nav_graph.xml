<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/signInFragment">

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.capetowncoffees.ui.auth.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_sign_in">
        
        <action
            android:id="@+id/action_signInFragment_to_signUpFragment"
            app:destination="@id/signUpFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
            
        <action
            android:id="@+id/action_signInFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
            
    </fragment>
    
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.capetowncoffees.ui.auth.SignUpFragment"
        android:label="Create Account"
        tools:layout="@layout/fragment_sign_up">
        
        <action
            android:id="@+id/action_signUpFragment_to_signInFragment"
            app:destination="@id/signInFragment"
            app:enterAnim="@anim/slide_in_left"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_left" />
            
        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
            
    </fragment>
    
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.capetowncoffees.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home_new">
        
        <action
            android:id="@+id/action_homeFragment_self"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
            
    </fragment>

    <fragment
        android:id="@+id/savedFragment"
        android:name="com.example.capetowncoffees.ui.saved.SavedFragment"
        android:label="Saved"
        tools:layout="@layout/fragment_saved" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.capetowncoffees.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        
        <action
            android:id="@+id/action_profileFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
            
    </fragment>
    
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.capetowncoffees.ui.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/createListFragment"
        android:name="com.example.capetowncoffees.ui.saved.CreateListFragment"
        android:label="Create List"
        tools:layout="@layout/fragment_create_list" />

    <fragment
        android:id="@+id/favouritesFragment"
        android:name="com.example.capetowncoffees.ui.saved.FavouritesFragment"
        android:label="Favourites"
        tools:layout="@layout/fragment_favourites" />

    <fragment
        android:id="@+id/cafeDetailFragment"
        android:name="com.example.capetowncoffees.ui.saved.CafeDetailFragment"
        android:label="Cafe Detail"
        tools:layout="@layout/fragment_cafe_detail" />

    <fragment
        android:id="@+id/reviewStep1Fragment"
        android:name="com.example.capetowncoffees.ui.saved.review.ReviewStep1Fragment"
        android:label="Review Step 1"
        tools:layout="@layout/fragment_review_step1" />

    <fragment
        android:id="@+id/reviewStep2Fragment"
        android:name="com.example.capetowncoffees.ui.saved.review.ReviewStep2Fragment"
        android:label="Review Step 2"
        tools:layout="@layout/fragment_review_step2" />

    <fragment
        android:id="@+id/reviewStep3Fragment"
        android:name="com.example.capetowncoffees.ui.saved.review.ReviewStep3Fragment"
        android:label="Review Step 3"
        tools:layout="@layout/fragment_review_step3" />

    <fragment
        android:id="@+id/reviewCompleteFragment"
        android:name="com.example.capetowncoffees.ui.saved.review.ReviewCompleteFragment"
        android:label="Review Complete"
        tools:layout="@layout/fragment_review_complete" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.capetowncoffees.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
